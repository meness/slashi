  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p src/webview --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage && node scripts/coverage-badge.mjs",
    "test:smoke": "npm run build && node test/smoke/run.cjs",
    "test:integration": "npm run build && tsc -p test/integration && vscode-test",
    "test:e2e": "npm run build && tsc -p test/e2e && node test/e2e/out/run.js",
    "bench": "node scripts/bench.mjs",
    "screenshots": "npm run test:smoke && node scripts/screenshots.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && vitest run --coverage && node scripts/coverage-badge.mjs --check && npm run test:smoke && node scripts/marketplace.mjs --check",
    "package": "npm run build -- --production && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build -- --production",
    "marketplace": "node scripts/marketplace.mjs",
    "icon": "node scripts/icon.mjs",
    "prepare": "lefthook install"
  },
