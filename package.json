{
  "name": "slashi",
  "displayName": "Slashi — Slash Commands for Everything",
  "description": "One beautiful, keyboard-first popup to do 99% of your VS Code work with a slash: files, settings, extensions, git, terminal, AI and your own commands.",
  "version": "0.3.0",
  "publisher": "meness",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#14111f",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/meness/slashi.git"
  },
  "bugs": {
    "url": "https://github.com/meness/slashi/issues"
  },
  "homepage": "https://github.com/meness/slashi#readme",
  "sponsor": {
    "url": "https://github.com/meness/slashi/blob/main/DONATE.md"
  },
  "keywords": [
    "slash",
    "command palette",
    "launcher",
    "spotlight",
    "raycast",
    "productivity",
    "keyboard",
    "ai",
    "llm",
    "copilot",
    "ollama",
    "claude",
    "macros"
  ],
  "categories": [
    "Other",
    "AI",
    "Keymaps",
    "Snippets"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces Slashi ignores workspace-defined custom commands (settings and .vscode/slashi.json).",
      "restrictedConfigurations": [
        "slashi.customCommands"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Terminal, tasks and package-script features are unavailable in virtual workspaces."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "slashi.open",
        "title": "Open",
        "category": "Slashi",
        "icon": "$(terminal-cmd)"
      },
      {
        "command": "slashi.welcome",
        "title": "Welcome & Onboarding",
        "category": "Slashi",
        "icon": "$(rocket)"
      },
      {
        "command": "slashi.openNative",
        "title": "Open (Native Quick Pick)",
        "category": "Slashi"
      },
      {
        "command": "slashi.run",
        "title": "Run a Slash Command…",
        "category": "Slashi"
      },
      {
        "command": "slashi.openFiles",
        "title": "Files & Folders",
        "category": "Slashi"
      },
      {
        "command": "slashi.openSettings",
        "title": "Search Settings",
        "category": "Slashi"
      },
      {
        "command": "slashi.openExtensions",
        "title": "Search Extensions",
        "category": "Slashi"
      },
      {
        "command": "slashi.openAI",
        "title": "AI Commands",
        "category": "Slashi"
      },
      {
        "command": "slashi.openGit",
        "title": "Git Commands",
        "category": "Slashi"
      },
      {
        "command": "slashi.openProject",
        "title": "Project Commands (Scripts & Tools)",
        "category": "Slashi"
      },
      {
        "command": "slashi.openTerminal",
        "title": "Terminal & Tasks",
        "category": "Slashi"
      },
      {
        "command": "slashi.openCustom",
        "title": "My Commands",
        "category": "Slashi"
      },
      {
        "command": "slashi.openMarketplace",
        "title": "Browse Action Marketplace",
        "category": "Slashi",
        "icon": "$(extensions)"
      },
      {
        "command": "slashi.installPack",
        "title": "Install Action Pack from URL or File…",
        "category": "Slashi"
      },
      {
        "command": "slashi.exportPack",
        "title": "Export My Commands as an Action Pack",
        "category": "Slashi"
      },
      {
        "command": "slashi.doWithAI",
        "title": "Do With AI…",
        "category": "Slashi",
        "icon": "$(sparkle)"
      },
      {
        "command": "slashi.ask",
        "title": "Ask AI…",
        "category": "Slashi"
      },
      {
        "command": "slashi.studio",
        "title": "Open Studio (Providers, AI & Commands)",
        "category": "Slashi",
        "icon": "$(settings-gear)"
      },
      {
        "command": "slashi.toggleProviders",
        "title": "Enable/Disable Providers",
        "category": "Slashi"
      },
      {
        "command": "slashi.selectModel",
        "title": "Select AI Model",
        "category": "Slashi"
      },
      {
        "command": "slashi.setApiKey",
        "title": "Set AI API Key",
        "category": "Slashi"
      },
      {
        "command": "slashi.clearApiKey",
        "title": "Clear AI API Key",
        "category": "Slashi"
      },
      {
        "command": "slashi.newCommand",
        "title": "Create Custom Command",
        "category": "Slashi"
      },
      {
        "command": "slashi.editTeamCommands",
        "title": "Edit Team Commands (.vscode/slashi.json)",
        "category": "Slashi"
      },
      {
        "command": "slashi.customizeShortcuts",
        "title": "Customize Keyboard Shortcuts",
        "category": "Slashi"
      },
      {
        "command": "slashi.clearHistory",
        "title": "Clear Recent History",
        "category": "Slashi"
      },
      {
        "command": "slashi.copyDiagnostics",
        "title": "Copy Diagnostics for a Bug Report",
        "category": "Slashi"
      },
      {
        "command": "slashi.refresh",
        "title": "Refresh Search Results",
        "category": "Slashi"
      },
      {
        "command": "slashi.inlineRun",
        "title": "Run Inline Slash Command",
        "category": "Slashi"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "slashi.inlineRun",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "slashi.open",
          "group": "navigation@99",
          "when": "config.slashi.editorTitleButton"
        }
      ]
    },
    "keybindings": [
      {
        "command": "slashi.open",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "config.slashi.shortcut.useSlashKey"
      },
      {
        "command": "editor.action.commentLine",
        "key": "ctrl+alt+/",
        "mac": "cmd+alt+/",
        "when": "editorTextFocus && !editorReadonly && config.slashi.shortcut.useSlashKey"
      },
      {
        "command": "slashi.open",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+;",
        "when": "!config.slashi.shortcut.useSlashKey"
      },
      {
        "command": "slashi.doWithAI",
        "key": "ctrl+shift+alt+/",
        "mac": "ctrl+cmd+/"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          ".vscode/slashi.json",
          "slashi.json",
          "*.slashi-pack.json",
          "marketplace/packs/*.json"
        ],
        "url": "./schemas/slashi.schema.json"
      }
    ],
    "configuration": [
      {
        "title": "General",
        "order": 0,
        "properties": {
          "slashi.shortcut.useSlashKey": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Open Slashi with `Cmd+/` (macOS) or `Ctrl+/` (Windows/Linux). **Toggle Line Comment** moves to `Cmd+Alt+/` / `Ctrl+Alt+/`. Turn off to keep VS Code's comment shortcut; Slashi then opens with `Cmd+Shift+;` / `Ctrl+Shift+/`. Any key can be rebound in Keyboard Shortcuts."
          },
          "slashi.popup.style": {
            "type": "string",
            "enum": [
              "spotlight",
              "native"
            ],
            "enumDescriptions": [
              "Beautiful centred Spotlight popup (custom design, live previews, action menus).",
              "VS Code's native Quick Pick (fastest, follows every accessibility setting)."
            ],
            "default": "spotlight",
            "description": "Which popup Slashi opens."
          },
          "slashi.popup.maxResults": {
            "type": "number",
            "default": 60,
            "minimum": 10,
            "maximum": 500,
            "description": "Maximum number of results shown in the popup."
          },
          "slashi.popup.showDescriptions": {
            "type": "boolean",
            "default": true,
            "description": "Show a description line under each result."
          },
          "slashi.statusBar.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Show the Slashi button in the status bar."
          },
          "slashi.editorTitleButton": {
            "type": "boolean",
            "default": false,
            "description": "Show a Slashi button in the editor title bar."
          },
          "slashi.inlineTrigger.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Typing `/` as the first character of a line suggests slash commands right in the editor."
          },
          "slashi.inlineTrigger.languages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "markdown",
              "plaintext",
              "scminput"
            ],
            "description": "Language IDs in which the inline `/` trigger is active. Use `*` for all languages."
          },
          "slashi.history.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Remember what you run to rank frequent and recent commands first."
          },
          "slashi.files.maxIndexed": {
            "type": "number",
            "default": 20000,
            "minimum": 1000,
            "description": "Maximum number of workspace files and folders indexed by the Files provider."
          },
          "slashi.files.confirmDelete": {
            "type": "boolean",
            "default": true,
            "description": "Ask before deleting files or folders (they are moved to the trash when possible)."
          },
          "slashi.terminal.reuse": {
            "type": "boolean",
            "default": true,
            "description": "Reuse a single `Slashi` terminal for `/run` instead of creating a new one each time."
          },
          "slashi.web.engines": {
            "type": "object",
            "scope": "machine",
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "markdownDescription": "Extra web search engines. Key = slash name, value = an `https://` (or `http://`) URL with `%s` for the query. Example: `{ \"rust\": \"https://docs.rs/releases/search?query=%s\" }`. An engine with a built-in name replaces it. User settings only: a repository can't change where your searches go."
          },
          "slashi.marketplace.registries": {
            "type": "array",
            "scope": "machine",
            "items": {
              "type": "string"
            },
            "default": [
              "https://raw.githubusercontent.com/meness/slashi/main/marketplace/index.json"
            ],
            "markdownDescription": "Registry index URLs (HTTPS) that `/market` browses. Add your company's private registry here."
          }
        }
      },
      {
        "title": "Providers",
        "order": 1,
        "properties": {
          "slashi.providers.files": {
            "type": "boolean",
            "default": true,
            "description": "Files & Folders: search, create, open, rename, move, duplicate, delete, copy path, reveal."
          },
          "slashi.providers.navigation": {
            "type": "boolean",
            "default": true,
            "description": "Navigation: open tabs, symbols in file, problems, go to line."
          },
          "slashi.providers.project": {
            "type": "boolean",
            "default": true,
            "description": "Project: auto-detects your stack (npm/pnpm/yarn/bun, scripts, frameworks, Docker, Make, Python, Rust, Go, .NET, Java…) and adds matching slash commands."
          },
          "slashi.providers.commands": {
            "type": "boolean",
            "default": true,
            "description": "Commands: VS Code commands and commands contributed by installed extensions."
          },
          "slashi.providers.settings": {
            "type": "boolean",
            "default": true,
            "description": "VS Code Settings: search, toggle and edit any setting."
          },
          "slashi.providers.extensions": {
            "type": "boolean",
            "default": true,
            "description": "VS Code Extensions: browse installed extensions, run their commands, search and install."
          },
          "slashi.providers.ai": {
            "type": "boolean",
            "default": true,
            "description": "AI: ask, explain, fix, document, test, review and edit code, and write commit messages."
          },
          "slashi.providers.naturalLanguage": {
            "type": "boolean",
            "default": true,
            "description": "Natural language: describe a task in plain English and let your AI model turn it into actions."
          },
          "slashi.providers.transforms": {
            "type": "boolean",
            "default": true,
            "description": "Text tools: case conversion, sorting, JSON, Base64, URL, UUID, hashes and more."
          },
          "slashi.providers.terminal": {
            "type": "boolean",
            "default": true,
            "description": "Terminal: run shell commands, package scripts and VS Code tasks."
          },
          "slashi.providers.git": {
            "type": "boolean",
            "default": true,
            "description": "Git: commit, push, pull, branches, stash and AI commit messages."
          },
          "slashi.providers.themes": {
            "type": "boolean",
            "default": true,
            "description": "Themes: switch color and icon themes."
          },
          "slashi.providers.web": {
            "type": "boolean",
            "default": true,
            "description": "Web: search Google, Stack Overflow, GitHub, MDN, npm and your own engines."
          },
          "slashi.providers.custom": {
            "type": "boolean",
            "default": true,
            "description": "My Commands: your own and your team's custom commands."
          },
          "slashi.providers.marketplace": {
            "type": "boolean",
            "default": true,
            "description": "Marketplace: browse, install and update community Slashi action packs."
          },
          "slashi.disabledFeatures": {
            "type": "array",
            "uniqueItems": true,
            "default": [],
            "items": {
              "type": "string",
              "enum": [
                "files.search",
                "files.create",
                "files.rename",
                "files.duplicate",
                "files.delete",
                "files.clipboard",
                "files.reveal",
                "navigation.tabs",
                "navigation.symbols",
                "navigation.problems",
                "navigation.goToLine",
                "project.scripts",
                "project.packageManager",
                "project.tools",
                "commands.core",
                "commands.extensionCommands",
                "settings.core",
                "settings.extensionSettings",
                "extensions.installed",
                "extensions.marketplace",
                "extensions.management",
                "ai.ask",
                "ai.code",
                "ai.commitMessage",
                "ai.generate",
                "ai.models",
                "transforms.case",
                "transforms.lines",
                "transforms.encode",
                "transforms.json",
                "transforms.generate",
                "transforms.stats",
                "terminal.run",
                "terminal.tasks",
                "terminal.manage",
                "git.core",
                "git.branches",
                "git.stash",
                "themes.color",
                "themes.icon",
                "themes.toggle",
                "web.builtin",
                "web.custom",
                "custom.user",
                "custom.team",
                "custom.extensions",
                "custom.packs"
              ]
            },
            "markdownDescription": "Turn off individual features inside a provider while keeping the rest, e.g. `extensions.installed` keeps marketplace search but hides installed extensions. Easier: use **Slashi: Enable/Disable Providers** or the Studio."
          },
          "slashi.hiddenCommands": {
            "type": "array",
            "uniqueItems": true,
            "default": [],
            "items": {
              "type": "string"
            },
            "markdownDescription": "Hide individual results by ID (shown in the actions menu → *Hide from Slashi*). Supports a trailing `*` wildcard, e.g. `cmd:workbench.action.debug.*`."
          }
        }
      },
      {
        "title": "AI",
        "order": 2,
        "properties": {
          "slashi.ai.provider": {
            "type": "string",
            "scope": "machine",
            "enum": [
              "auto",
              "vscode",
              "anthropic",
              "openai",
              "ollama",
              "openaiCompatible",
              "claudeCode",
              "codex"
            ],
            "enumDescriptions": [
              "Use an installed VS Code chat model (e.g. GitHub Copilot), then an API key, then a signed-in Claude Code / Codex CLI, otherwise a local Ollama server.",
              "VS Code Language Model API — models from installed extensions such as GitHub Copilot.",
              "Anthropic Claude (API key required).",
              "OpenAI (API key required).",
              "Local Ollama server (no key needed).",
              "Any OpenAI-compatible endpoint: LM Studio, Groq, OpenRouter, Together, Mistral, vLLM…",
              "Claude Code CLI or VS Code extension — uses your Claude sign-in, no API key.",
              "OpenAI Codex CLI — uses your ChatGPT sign-in, no API key."
            ],
            "default": "auto",
            "description": "Which AI provider Slashi uses."
          },
          "slashi.ai.model": {
            "type": "string",
            "scope": "machine",
            "default": "",
            "markdownDescription": "Model ID. Leave empty for the backend default (`claude-opus-5-5` for Anthropic, `gpt-4o-mini` for OpenAI, the first installed model for VS Code / Ollama). Use `/models` to pick from installed models."
          },
          "slashi.ai.baseUrl": {
            "type": "string",
            "scope": "machine",
            "default": "",
            "markdownDescription": "Base URL for `ollama` (default `http://localhost:11434/v1`) and `openaiCompatible` backends, e.g. `http://localhost:1234/v1` for LM Studio."
          },
          "slashi.ai.anthropicEffort": {
            "type": "string",
            "scope": "machine",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "default": "medium",
            "description": "Anthropic effort level: lower is faster and cheaper, higher is more thorough."
          },
          "slashi.ai.confirmBeforeRun": {
            "type": "boolean",
            "default": true,
            "scope": "machine",
            "description": "Show the plan produced by Do-with-AI and ask before running it. Steps that can run shell commands (terminal, scripts, custom commands, terminal and Slashi settings) are always confirmed."
          },
          "slashi.ai.customInstructions": {
            "type": "string",
            "default": "",
            "editPresentation": "multilineText",
            "scope": "machine",
            "description": "Extra instructions added to every AI request (e.g. coding style, preferred language)."
          },
          "slashi.ai.includeFileContext": {
            "type": "boolean",
            "default": true,
            "description": "When nothing is selected, include the active file as context for AI commands."
          }
        }
      },
      {
        "title": "Custom Commands",
        "order": 3,
        "properties": {
          "slashi.customCommands": {
            "type": "array",
            "default": [],
            "markdownDescription": "Your own slash commands. Use `/new-command` to create one without editing JSON. Team commands can live in `.vscode/slashi.json`. See the README for all step types and variables.",
            "items": {
              "type": "object",
              "required": [
                "name",
                "steps"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
                  "description": "The slash name: \"ship\" → /ship"
                },
                "title": {
                  "type": "string",
                  "description": "Shown in the popup."
                },
                "description": {
                  "type": "string"
                },
                "icon": {
                  "type": "string",
                  "description": "Phosphor icon name, e.g. rocket-launch (https://phosphoricons.com)."
                },
                "args": {
                  "type": "string",
                  "description": "Placeholder for arguments typed after the name; available as ${args}."
                },
                "languages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Only show in these language IDs."
                },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "description": "Exactly one action per step. Strings support ${args}, ${q:args} (shell-quoted), ${selection}, ${file}, ${fileBasename}, ${fileDirname}, ${relativeFile}, ${workspaceFolder}, ${lineNumber}, ${language}, ${date}, ${time}, ${datetime}, ${uuid}, ${clipboard}, ${env:NAME}, ${config:key}, ${input:var} and ${name:default}.",
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "command"
                        ],
                        "properties": {
                          "command": {
                            "type": "string",
                            "description": "VS Code command ID."
                          },
                          "args": {
                            "description": "Argument passed to the command."
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "slash"
                        ],
                        "properties": {
                          "slash": {
                            "type": "string",
                            "description": "Another slash command, e.g. \"/format\" or \"/run npm test\"."
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "terminal"
                        ],
                        "properties": {
                          "terminal": {
                            "type": "string",
                            "description": "Shell command."
                          },
                          "name": {
                            "type": "string",
                            "description": "Terminal name."
                          },
                          "cwd": {
                            "type": "string",
                            "description": "Working directory, relative to the workspace."
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "setting",
                          "value"
                        ],
                        "properties": {
                          "setting": {
                            "type": "string"
                          },
                          "value": {},
                          "target": {
                            "enum": [
                              "user",
                              "workspace"
                            ]
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "insert"
                        ],
                        "properties": {
                          "insert": {
                            "type": "string",
                            "description": "Text to insert at the cursor (replaces the selection)."
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "open"
                        ],
                        "properties": {
                          "open": {
                            "type": "string",
                            "description": "https:// URL or workspace-relative path."
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "ai"
                        ],
                        "properties": {
                          "ai": {
                            "type": "string",
                            "description": "Prompt sent to your AI model."
                          },
                          "output": {
                            "enum": [
                              "panel",
                              "replace",
                              "insert"
                            ],
                            "default": "panel"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "notify"
                        ],
                        "properties": {
                          "notify": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "input",
                          "var"
                        ],
                        "properties": {
                          "input": {
                            "type": "string",
                            "description": "Prompt shown to the user."
                          },
                          "var": {
                            "type": "string",
                            "description": "Variable name, used as ${input:name}."
                          },
                          "placeholder": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "pick",
                          "var"
                        ],
                        "properties": {
                          "pick": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "var": {
                            "type": "string"
                          },
                          "placeholder": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "required": [
                          "wait"
                        ],
                        "properties": {
                          "wait": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 60000
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "slashi.welcome",
        "title": "Get started with Slashi",
        "description": "Do 99% of your VS Code work from one slash popup — no mouse needed.",
        "steps": [
          {
            "id": "open",
            "title": "Open Slashi",
            "description": "Press **Cmd+/** on macOS or **Ctrl+/** on Windows/Linux or click **/ Slashi** in the status bar. Type `/` and a few letters.\n[Open Slashi](command:slashi.open)",
